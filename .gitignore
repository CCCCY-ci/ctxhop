# === Build output ===
# Anchored to the repository root: bare command names would also match the
# cmd/ctxhop source directory.
/dist/
/build/
/ctxhop
/ctxhop.exe
*.exe
*.dll
*.so
*.dylib
*.a
.claude/
# Keep release and CI workflows versioned; other generated GitHub metadata may
# remain local unless it is explicitly added later.
.github/*
!.github/
!.github/workflows/
!.github/workflows/*.yml
docs/
# Keep only the build and release entry points versioned. Ad-hoc local scripts
# remain ignored.
scripts/*
!scripts/
!scripts/build.sh
!scripts/build.ps1
!scripts/release.sh
!scripts/render-packages.sh
examples/

# === Test code and data ===
# Repository regression tests are versioned; local fixtures remain ignored.
**/testdata/
**/__snapshots__/

# Tests used only for local/manual verification. These are intentionally kept
# out of the release branch.
/internal/environment/config_apply_test.go
/internal/environment/global_override_test.go
/internal/environment/inspect_test.go
/internal/environment/settings_scope_test.go
/internal/gitstate/apply_test.go
/internal/gitstate/capture_test.go
/internal/syncer/compression_metadata_test.go
/internal/syncer/git_test.go
/internal/syncer/workspace_test.go
/internal/workspace/apply_test.go
/internal/workspace/directory_test.go
/internal/workspace/snapshot_test.go

*.test
*.out
*.prof
*.pprof
coverage.*
!coverage.md

# Fuzzing corpora, including crashers, which can embed whatever input
# triggered them.
**/testdata/fuzz/
/fuzz/

# === Go tooling ===
vendor/
go.work
go.work.sum

# Local build and browser-test caches
/.edge-profile*/
**/.edge-profile*/
/.gocache-*/
/.gotmp-*/
/.tmp-go-*/
/.tmp-release-*
/.npm-cache-figma/

# === Secrets and local configuration ===
# Nothing resembling a credential may ever be committed: this repository is
# meant to be public, and git history is permanent.
.env
.env.*
*.local
config.local.*
*.credentials.json
*credentials*
*secret*
# The encrypted local secret-storage implementation is versioned source, not user data.
!internal/config/secrets.go
!internal/config/secrets_test.go
*.pem
*.key
*.p12
*.pfx
id_rsa*
.netrc
/r2test

# === Real agent data ===
# Working copies taken from a real installation while investigating. Session
# bodies can contain source code, terminal output and API keys.
/testdata/real/
*.jsonl
/scratch/
/tmp/
/.test-tmp/

# === Editors and OS ===
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
desktop.ini

# === Claude Code local state ===
# Project rules under .claude/rules/ are tracked deliberately; per-machine
# settings are not.
.claude/settings.local.json
.claude/*.local.json

# === Deferred UI build output (not part of the CLI release) ===
web/node_modules/
web/dist/
/cmd/ctxhop/webdist/
.npm-cache-ui/
