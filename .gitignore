# === Build output ===
# Anchored to the repository root: a bare "agentsync" would also match the
# cmd/agentsync source directory.
/dist/
/build/
/agentsync
/agentsync.exe
*.exe
*.dll
*.so
*.dylib
*.a

# === Test code and data ===
# Tests stay local and are never committed.
**/*_test.go
**/testdata/
**/__snapshots__/
*.test
*.out
*.prof
*.pprof
coverage.*
!coverage.md

# Fuzzing corpora, including crashers, which can embed whatever input
# triggered them.
**/testdata/fuzz/
/fuzz/

# === Go tooling ===
vendor/
go.work
go.work.sum

# === Secrets and local configuration ===
# Nothing resembling a credential may ever be committed: this repository is
# meant to be public, and git history is permanent.
.env
.env.*
*.local
config.local.*
*.credentials.json
*credentials*
*secret*
*.pem
*.key
*.p12
*.pfx
id_rsa*
.netrc

# === Real agent data ===
# Working copies taken from a real installation while investigating. Session
# bodies can contain source code, terminal output and API keys.
/testdata/real/
*.jsonl
/scratch/
/tmp/

# === Editors and OS ===
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
desktop.ini

# === Claude Code local state ===
# Project rules under .claude/rules/ are tracked deliberately; per-machine
# settings are not.
.claude/settings.local.json
.claude/*.local.json
