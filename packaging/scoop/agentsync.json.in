{
  "version": "@VERSION@",
  "description": "Encrypted cross-device sync for AI coding agent sessions",
  "homepage": "https://github.com/CCCCY-ci/agentsync",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/CCCCY-ci/agentsync/releases/download/v@VERSION@/agentsync_@VERSION@_windows_amd64.exe",
      "hash": "@WINDOWS_AMD64_SHA256@",
      "bin": [["agentsync_@VERSION@_windows_amd64.exe", "agentsync.exe"]]
    },
    "arm64": {
      "url": "https://github.com/CCCCY-ci/agentsync/releases/download/v@VERSION@/agentsync_@VERSION@_windows_arm64.exe",
      "hash": "@WINDOWS_ARM64_SHA256@",
      "bin": [["agentsync_@VERSION@_windows_arm64.exe", "agentsync.exe"]]
    }
  },
  "checkver": {
    "github": "https://github.com/CCCCY-ci/agentsync"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/CCCCY-ci/agentsync/releases/download/v$version/agentsync_$version_windows_amd64.exe"
      },
      "arm64": {
        "url": "https://github.com/CCCCY-ci/agentsync/releases/download/v$version/agentsync_$version_windows_arm64.exe"
      }
    }
  }
}
