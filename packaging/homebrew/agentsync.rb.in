class Agentsync < Formula
  desc "Encrypted cross-device sync for AI coding agent sessions"
  homepage "https://github.com/CCCCY-ci/agentsync"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/CCCCY-ci/agentsync/releases/download/v@VERSION@/agentsync_@VERSION@_darwin_arm64"
      sha256 "@DARWIN_ARM64_SHA256@"
    else
      url "https://github.com/CCCCY-ci/agentsync/releases/download/v@VERSION@/agentsync_@VERSION@_darwin_amd64"
      sha256 "@DARWIN_AMD64_SHA256@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/CCCCY-ci/agentsync/releases/download/v@VERSION@/agentsync_@VERSION@_linux_arm64"
      sha256 "@LINUX_ARM64_SHA256@"
    else
      url "https://github.com/CCCCY-ci/agentsync/releases/download/v@VERSION@/agentsync_@VERSION@_linux_amd64"
      sha256 "@LINUX_AMD64_SHA256@"
    end
  end

  def install
    bin.install Dir["agentsync_*"].first => "agentsync"
  end

  test do
    assert_match "agentsync", shell_output("#{bin}/agentsync version")
  end
end
